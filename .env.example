# ============================================================
# StudentAbroad — Environment Variables (.env)
# ============================================================
# Скопіюй цей файл як .env і заповни значення:
#   cp .env.example .env
#
# ⚠️  НІКОЛИ не комітьте .env у Git!
# ============================================================

# --- Django Core ---
# Згенерувати: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# True для локальної розробки, False для продакшну
DEBUG=True

# Через кому, без пробілів
# Для локальної розробки: localhost,127.0.0.1
# Для продакшну: studentabroad.org.ua,www.studentabroad.org.ua,IP_СЕРВЕРА
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DATABASE_NAME=studentabroad_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your-database-password-here
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- CORS ---
# Через кому, без пробілів. Для локальної розробки:
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# --- CSRF ---
# Для продакшну: https://studentabroad.org.ua,https://www.studentabroad.org.ua
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- HTTPS Security ---
# Тільки True якщо є SSL-сертифікат
SECURE_SSL_REDIRECT=False

# --- Cloudflare Turnstile (Anti-bot CAPTCHA) ---
# Отримати ключі: https://dash.cloudflare.com/?to=/:account/turnstile
# Якщо не задано — Turnstile вимкнений (для локальної розробки це нормально)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudflare R2 (Media Storage) ---
# Ключі створюються в панелі Cloudflare R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=studentabroad-media
AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Публічний URL (без https://), який ви увімкнули в налаштуваннях бакета
AWS_S3_CUSTOM_DOMAIN=pub-вашкод.r2.dev
